<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.UpdateCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Car" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Update Car" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Car ID:" Margin="0,5"/>
            <TextBox Name="CarIdTextBox" Margin="0,5"/>

            <TextBlock Text="New Brand:" Margin="0,5"/>
            <TextBox Name="BrandTextBox" Margin="0,5"/>

            <TextBlock Text="New Model:" Margin="0,5"/>
            <TextBox Name="ModelTextBox" Margin="0,5"/>

            <Button Content="Update" Height="40" Margin="0,10" Click="UpdateCar_Click"/>
            <Button Content="Back" Height="30" Background="Red" Foreground="White" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
