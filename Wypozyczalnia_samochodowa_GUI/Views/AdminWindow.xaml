<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Administratora" Height="600" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">

    <Grid>
        <Border Background="White" CornerRadius="15" BorderThickness="2" BorderBrush="LightSteelBlue"
        Padding="10" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">

                <!-- Nagłówek -->
                <TextBlock Text="Panel Administratora" FontSize="22" FontWeight="Bold" 
                           Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,0,0,20"
                           TextDecorations="Underline"/>

                <!-- Opcje dla administratora -->
                <Button Content="List available cars" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Make a reservation" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Update profile" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Show reservations" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Delete reservation" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Manage customers" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Manage cars" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>

                <!-- Przycisk Exit -->
                <Button Content="Exit" Height="40" Margin="0,20,0,0" Background="Red" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
