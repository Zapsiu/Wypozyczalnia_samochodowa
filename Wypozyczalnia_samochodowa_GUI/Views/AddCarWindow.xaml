<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Car" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Add New Car" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Brand:" Margin="0,5"/>
            <TextBox Name="BrandTextBox" Margin="0,5"/>
            <TextBlock Text="Model:" Margin="0,5"/>
            <TextBox Name="ModelTextBox" Margin="0,5"/>
            <TextBlock Text="Registration Number:" Margin="0,5"/>
            <TextBox Name="RegistrationNumberTextBox" Margin="0,5"/>
            <Button Content="Add Car" Height="40" Margin="0,10"/>
            <Button Content="Back" Height="30" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
