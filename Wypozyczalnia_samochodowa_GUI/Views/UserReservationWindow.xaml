<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.UserReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make a Reservation" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Make a Reservation" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Select Car:" Margin="0,5"/>
            <ComboBox Name="CarComboBox" Margin="0,5" DisplayMemberPath="Model"/>
            <TextBlock Text="Start Date:" Margin="0,5"/>
            <DatePicker Name="StartDatePicker" Margin="0,5"/>
            <TextBlock Text="End Date:" Margin="0,5"/>
            <DatePicker Name="EndDatePicker" Margin="0,5"/>
            <Button Content="Reserve" Height="40" Margin="0,10" Click="Reserve_Click"/>
            <Button Content="Back" Height="30" Background="Red" Foreground="White" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
