<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.AdminReservationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation List" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <!-- Nagłówek -->
            <TextBlock Text="Reservation List" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>

            <!-- Lista rezerwacji -->
            <ListBox Name="ReservationListBox" Margin="0,10" 
                     FontSize="14" BorderThickness="1" BorderBrush="LightGray"/>

            <!-- Przycisk powrotu -->
            <Button Content="Back" Height="30" Background="Red" Foreground="White" 
                    FontWeight="SemiBold" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
