<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.CarListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car List" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <!-- Nagłówek -->
            <TextBlock Text="Car List" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>

            <!-- Lista pojazdów -->
            <ListBox Name="CarListBox" Margin="0,10" 
                     DisplayMemberPath="DisplayCarDetails" />

            <!-- Przycisk Back -->
            <Button Content="Back" Height="30" Background="Red" Foreground="White" 
                    Click="Back_Click" />
        </StackPanel>
    </Grid>
</Window>
