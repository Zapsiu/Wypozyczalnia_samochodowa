<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.DeleteCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Car" Height="300" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Delete Car" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Car ID:" Margin="0,5"/>
            <TextBox Name="CarIdTextBox" Margin="0,5"/>
            <Button Content="Delete Car" Height="40" Margin="0,10"/>
            <Button Content="Back" Height="30" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
