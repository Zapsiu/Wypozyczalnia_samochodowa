<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.AdminUserListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User List" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="User List" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <ListBox Name="UserListBox" Margin="0,10" DisplayMemberPath="Username"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button Content="Edit User" Width="100" Margin="5" Click="EditUser_Click"/>
                <Button Content="Delete User" Width="100" Margin="5" Background="Red" 
                        Foreground="White" Click="DeleteUser_Click"/>
            </StackPanel>

            <Button Content="Back" Height="30" Background="Red" Foreground="White" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
