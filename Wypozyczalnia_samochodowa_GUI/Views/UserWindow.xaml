<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Użytkownika" Height="500" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">

    <Grid>
        <Border Background="White" CornerRadius="15" BorderThickness="2" BorderBrush="LightSteelBlue"
                Padding="10" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">

                <!-- Nagłówek -->
                <TextBlock Text="Panel Użytkownika" FontSize="22" FontWeight="Bold" 
                           Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,0,0,20"
                           TextDecorations="Underline"/>

                <!-- Opcje dla użytkownika -->
                <Button Content="List available cars" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="ViewCars_Click"/>
                <Button Content="Make a reservation" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="MakeReservation_Click"/>
                <Button Content="Update profile" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="UpdateProfile_Click"/>
                <Button Content="Show reservations" Height="40" Margin="0,5" Background="#B0C4DE" 
                        Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="ViewReservations_Click"/>

                <!-- Przycisk Exit -->
                <Button Content="Exit" Height="40" Margin="0,20,0,0" Background="Red" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand" Click="Logout_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
