<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.UserCarListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car List" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Available Cars" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <ListBox Name="CarListBox" Margin="0,10" DisplayMemberPath="Model"/>
            <Button Content="Back" Height="30" Background="Red" Foreground="White" Click="Back"/>
        </StackPanel>
    </Grid>
</Window>
