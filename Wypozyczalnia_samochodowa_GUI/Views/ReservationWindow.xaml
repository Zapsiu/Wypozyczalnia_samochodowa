<Window x:Class="Wypozyczalnia_samochodowa_GUI.Views.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#E3F2FD">

    <Grid>
        <StackPanel Margin="20">
            <!-- Nagłówek -->
            <TextBlock Text="Make a Reservation" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10"/>

            <!-- Wybór samochodu -->
            <TextBlock Text="Select Car:" Margin="0,5"/>
            <ComboBox Name="CarComboBox" DisplayMemberPath="FullDetails" Margin="0,5"/>

            <!-- Wybór daty startowej -->
            <TextBlock Text="Start Date:" Margin="0,5"/>
            <DatePicker Name="StartDatePicker" Margin="0,5"/>

            <!-- Wybór daty końcowej -->
            <TextBlock Text="End Date:" Margin="0,5"/>
            <DatePicker Name="EndDatePicker" Margin="0,5"/>

            <!-- Przycisk Rezerwacji -->
            <Button Content="Reserve" Height="40" Margin="0,10" Click="OnReserveClick"/>

            <!-- Przycisk Powrotu -->
            <Button Content="Back" Height="30" Background="Red" Foreground="White" Click="OnBackClick"/>
        </StackPanel>
    </Grid>
</Window>
