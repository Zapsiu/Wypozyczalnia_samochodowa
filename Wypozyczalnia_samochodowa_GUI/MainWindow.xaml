<Window x:Class="Wypozyczalnia_samochodowa_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie - Wypożyczalnia Samochodowa" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinWidth="300" MinHeight="400">
    <!-- Gradientowe tło -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E3F2FD" Offset="0.0"/>
                <GradientStop Color="#90CAF9" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Zawartość główna z Viewbox dla skalowania -->
        <Viewbox Stretch="Uniform">
            <Border Background="White" CornerRadius="15" BorderThickness="2"
                    BorderBrush="LightSteelBlue" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <!-- Nagłówek -->
                    <TextBlock Text="Wypożyczalnia Samochodowa" FontSize="24" FontWeight="Bold"
                               Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,10,0,20"/>
                    <!-- Login z etykietą -->
                    <Grid Grid.Row="1" Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="100"/>
                            <!-- Szerokość dla etykiety -->
                            <ColumnDefinition/>
                            <!-- Reszta dla pola -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Login:" FontSize="14" FontWeight="SemiBold" Foreground="Gray"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" Height="18" Width="39"/>
                        <TextBox Name="UsernameTextBox" Grid.Column="1" Height="30" Padding="5" 
                                 VerticalAlignment="Center" BorderBrush="LightGray" Grid.ColumnSpan="2" Margin="44,0,0,0"/>
                    </Grid>
                    <!-- Hasło z etykietą -->
                    <Grid Grid.Row="2" Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <!-- Szerokość dla etykiety -->
                            <ColumnDefinition Width="*"/>
                            <!-- Reszta dla pola -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hasło: " FontSize="14" FontWeight="SemiBold" Foreground="Gray"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Height="18" Width="39" />
                        <PasswordBox Name="PasswordBox" Height="30" Padding="5" 
                                 VerticalAlignment="Center" BorderBrush="LightGray" Grid.ColumnSpan="2" Margin="44,0,0,0"/>
                    </Grid>
                    <!-- Przycisk Zaloguj -->
                    <Button Content="Zaloguj" Width="200" Height="40" Margin="0,10,0,0"
                            Background="#B0C4DE" Foreground="White" FontWeight="SemiBold" 
                            BorderThickness="0" Cursor="Hand" Click="LoginButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#B0C4DE"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#6A9ACD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Window>
